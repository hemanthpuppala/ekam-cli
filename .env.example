# VLM/LLM CLI Environment Configuration
# Copy this file to .env and fill in your values

# Note: All current providers (Ollama, HuggingFace local, LM Studio, GGUF)
# run locally and do not require API keys.
# This file is reserved for future cloud provider extensions.

# Application Settings
APP_ENV=development
LOG_LEVEL=INFO

# Model Cache Directories (override defaults)
# OLLAMA_MODELS=~/.ollama/models
# HUGGINGFACE_CACHE=~/.cache/huggingface
# GGUF_CACHE=~/.cache/vlm-cli/gguf
